{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maida-vale-qa",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maida-vale-qa-production",
      "database_id": "a7f6976f-9b27-418c-93d6-77f6570fe7cf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "maida-vale-qa-files"
    }
  ]
}
