{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maida-vale-qa-production",
      "database_id": "local-placeholder-will-be-set-on-deploy"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "maida-vale-qa-files"
    }
  ]
}
